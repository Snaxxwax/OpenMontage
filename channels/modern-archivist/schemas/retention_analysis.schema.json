{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Modern Archivist Retention Analysis Schema",
    "description": "Schema for documenting and analyzing video retention performance metrics and insights",
    "type": "object",
    "properties": {
        "video_id": {
            "type": "string",
            "description": "Unique identifier for the video"
        },
        "publish_date": {
            "type": "string",
            "format": "date",
            "description": "Date the video was published"
        },
        "total_views": {
            "type": "integer",
            "minimum": 0,
            "description": "Total number of views"
        },
        "retention_overview": {
            "type": "object",
            "properties": {
                "average_watch_percentage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Average percentage of video watched"
                },
                "audience_retention_curve": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "timestamp": {
                                "type": "number",
                                "description": "Timestamp in seconds"
                            },
                            "retention_percentage": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100,
                                "description": "Percentage of viewers still watching at this timestamp"
                            }
                        },
                        "required": ["timestamp", "retention_percentage"]
                    },
                    "description": "Detailed retention curve showing viewer dropoff"
                }
            },
            "required": ["average_watch_percentage"]
        },
        "key_moments": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "number",
                        "description": "Timestamp of the key moment in seconds"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["spike", "dip", "highlight", "transition"],
                        "description": "Type of key moment"
                    },
                    "description": {
                        "type": "string",
                        "description": "Explanation of the key moment and its impact"
                    }
                },
                "required": ["timestamp", "type", "description"]
            }
        },
        "ctr_analysis": {
            "type": "object",
            "properties": {
                "title_fit_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Score indicating how well the title matches the video content and attracts viewers"
                },
                "thumbnail_effectiveness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Score indicating the effectiveness of the thumbnail in attracting clicks"
                }
            }
        },
        "playbook_recommendations": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "category": {
                        "type": "string",
                        "description": "Area of recommendation (e.g., narrative, pacing, visual design)"
                    },
                    "recommendation": {
                        "type": "string",
                        "description": "Specific recommendation for improvement"
                    },
                    "priority": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Priority of the recommendation"
                    }
                },
                "required": ["category", "recommendation", "priority"]
            }
        }
    },
    "required": ["video_id", "publish_date", "total_views", "retention_overview"]
}