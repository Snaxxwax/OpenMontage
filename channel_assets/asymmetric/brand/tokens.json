{
  "schema_version": 1,
  "palette": {
    "near_black": "#1A1208",
    "deep_slate": "#F5EDE0",
    "graphite": "#D4CBBA",
    "bone": "#FFF8F0",
    "muted": "#8C7A68",
    "amber": "#C94B00",
    "cyan": "#1D6A8C",
    "red": "#B8291A"
  },
  "typography": {
    "headings": {
      "font": "Playfair Display",
      "weight": 700
    },
    "body": {
      "font": "Libre Baskerville",
      "weight": 400
    },
    "code": {
      "font": "IBM Plex Mono",
      "weight": 400
    },
    "stat_card": {
      "font": "IBM Plex Mono",
      "weight": 700
    }
  },
  "semantic_rules": {
    "amber": "leverage/chokepoint",
    "cyan": "structure/flow",
    "red": "consequence/failure/exposure only"
  },
  "style_rules": {
    "no_recurring_human_host_default": true,
    "prefer_hyperframes_native_svg_css": true,
    "stock_photo_documentary_not_default": true,
    "avoid": [
      "cyberpunk",
      "spy/intelligence fantasy",
      "control-room fantasy"
    ]
  }
}
