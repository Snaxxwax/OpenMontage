{
  "schema_version": 1,
  "package": {
    "name": "asymmetric-diagram-devices",
    "version": "0.1.0",
    "style_playbook": "styles/asymmetric.yaml",
    "brand_tokens": "channel_assets/asymmetric/brand/tokens.json"
  },
  "rules": {
    "default_duration_range_seconds": [2.0, 4.0],
    "max_static_state_seconds": 4.0,
    "color_semantics": {
      "amber": "leverage/chokepoint/control point only",
      "cyan": "structure/flow/system map only",
      "red": "consequence/failure/exposure only"
    },
    "non_decorative_signals": {
      "amber": true,
      "red": true
    }
  },
  "devices": [
    {
      "device_id": "amber-pivot-marker",
      "spec_path": "channel_assets/asymmetric/diagrams/devices/amber-pivot-marker/device.v1.spec.json",
      "template_path": "channel_assets/asymmetric/diagrams/devices/amber-pivot-marker/README.md",
      "semantic_category": "leverage_marker",
      "required_colors": ["amber"],
      "default_duration_range_seconds": [2.0, 4.0],
      "episode_importance": "must-have"
    },
    {
      "device_id": "chokepoint-ring",
      "spec_path": "channel_assets/asymmetric/diagrams/devices/chokepoint-ring/device.v1.spec.json",
      "template_path": "channel_assets/asymmetric/diagrams/devices/chokepoint-ring/README.md",
      "semantic_category": "leverage_marker",
      "required_colors": ["amber"],
      "default_duration_range_seconds": [2.0, 4.0],
      "episode_importance": "must-have"
    },
    {
      "device_id": "route-trace",
      "spec_path": "channel_assets/asymmetric/diagrams/devices/route-trace/device.v1.spec.json",
      "template_path": "channel_assets/asymmetric/diagrams/devices/route-trace/README.md",
      "semantic_category": "flow_map",
      "required_colors": ["cyan", "amber"],
