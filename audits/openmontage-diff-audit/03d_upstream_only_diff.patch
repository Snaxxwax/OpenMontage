-#!/usr/bin/env bash
-# Archive a project directory before a fresh run.
-# Usage: bash lib/archive_project.sh <project-name>
-#
-# Moves projects/<name>/ to projects/<name>_archived_<timestamp>/
-# so no generated assets are lost.
