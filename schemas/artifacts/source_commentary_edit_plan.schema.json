{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/source_commentary_edit_plan",
  "title": "Source Commentary Edit Plan",
  "description": "Detailed edit plan optimized for source-commentary alignment with polymorphic timeline items.",
  "type": "object",
  "required": ["version", "project_id", "timeline"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clip_type"],
        "properties": {
          "clip_type": {
            "type": "string",
            "enum": [
              "source_clip",
              "narration",
              "screenshot",
              "document",
              "graphic",
              "title_card",
              "transition"
            ]
          },
          "receipt_id": { "type": "string" },
          "claim_id": { "type": "string" },
          "local_clip_path": { "type": "string" },
          "source_label_plan": {
            "type": "object",
            "required": ["text", "position"],
            "properties": {
              "text": { "type": "string" },
              "position": {
                "type": "string",
                "enum": ["top-left", "top-right", "bottom-left", "bottom-right"]
              }
            },
            "additionalProperties": false
          },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false,
        "if": { "properties": { "clip_type": { "const": "source_clip" } } },
        "then": {
          "required": ["receipt_id", "claim_id", "local_clip_path", "source_label_plan"]
        }
      }
    }
  },
  "additionalProperties": false
}
