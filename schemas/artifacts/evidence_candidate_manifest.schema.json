{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/evidence_candidate_manifest",
  "title": "Evidence Candidate Manifest",
  "description": "Mapping of claims to potential source segments found via semantic search.",
  "type": "object",
  "required": ["version", "project_id", "candidates"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "claim_id",
          "source_id",
          "in_seconds",
          "out_seconds",
          "duration_seconds",
          "transcript_excerpt",
          "relevance_score",
          "rationale",
          "clip_role"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "claim_id": { "type": "string" },
          "source_id": { "type": "string" },
          "in_seconds": { "type": "number", "minimum": 0 },
          "out_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "transcript_excerpt": { "type": "string" },
          "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" },
          "clip_role": {
            "type": "string",
            "enum": ["primary_evidence", "quote_support", "supporting_context", "counter_argument", "timeline_proof", "public_reaction"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
