{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceCandidateManifest",
  "type": "object",
  "required": ["episode", "evidence"],
  "properties": {
    "episode": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim_id", "asset_type", "source_id", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "claim_id": { "type": "string" },
          "asset_type": {
            "type": "string",
            "enum": [
              "web_screenshot",
              "youtube_clip",
              "youtube_transcript",
              "social_screenshot",
              "document_excerpt",
              "diagram",
              "screen_recording",
              "generated_visual"
            ]
          },
          "source_id": { "type": "string" },
          "purpose": { "type": "string" },
          "timestamp_range": {
            "type": "object",
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            },
            "additionalProperties": false
          },
          "priority": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
