{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/scene_plan",
  "title": "Scene Plan",
  "description": "Ordered scene list produced by the Scene Planner agent.",
  "type": "object",
  "required": ["version", "scenes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_playbook": { "type": "string", "description": "Name of the active style playbook" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "start_seconds", "end_seconds"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["talking_head", "broll", "animation", "diagram", "text_card", "transition", "generated", "screen_recording"]
          },
          "description": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "script_section_id": { "type": "string" },
          "framing": { "type": "string" },
          "movement": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "overlay_notes": { "type": "string" },
          "viewer_hook": {
            "type": "string",
            "description": "Retention: The active viewer question or suspicion driving this scene (why they keep watching right now)."
          },
          "tension_type": {
            "type": "string",
            "enum": ["mystery", "contradiction", "escalation", "constraint", "substitution_failure", "consequence", "reversal", "hidden_actor", "bottleneck", "proof", "synthesis", "payoff"],
            "description": "Retention: Narrative tension category for this scene."
          },
          "visual_event_cadence_seconds": {
            "type": "number",
            "minimum": 1,
            "description": "Retention: Target cadence (seconds) for meaningful visual events inside this scene (default 5-8s for Asymmetric)."
          },
          "retention_function": {
            "type": "string",
            "description": "Retention: What this scene does to keep the viewer watching (open loop / mechanism / proof / contradiction / consequence / payoff / synthesis)."
          },
          "payoff_moment": {
            "type": "string",
            "description": "Retention: The specific beat that resolves or flips the tension inside the scene."
          },
          "next_open_loop": {
            "type": "string",
            "description": "Retention: The unresolved question the scene hands off to the next scene."
          },
          "shot_language": {
            "type": "object",
            "description": "Structured cinematography vocabulary for this scene",
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close_up", "extreme_close_up", "over_shoulder", "insert", "establishing"]
              },
              "camera_movement": {
                "type": "string",
                "enum": ["static", "pan_left", "pan_right", "tilt_up", "tilt_down", "dolly_in", "dolly_out", "tracking_left", "tracking_right", "crane_up", "crane_down", "handheld", "steadicam", "whip_pan", "orbital", "zoom_in", "zoom_out", "rack_focus"]
              },
              "lens_mm": { "type": "integer", "enum": [14, 24, 35, 50, 85, 135, 200] },
              "lighting_key": {
                "type": "string",
                "enum": ["high_key", "low_key", "natural", "golden_hour", "blue_hour", "tungsten_warm", "neon", "silhouette", "rim_lit", "volumetric", "overcast_soft"]
              },
              "depth_of_field": { "type": "string", "enum": ["shallow", "medium", "deep"] },
              "color_temperature": { "type": "string", "enum": ["cool", "neutral", "warm", "mixed"] }
            },
            "additionalProperties": false
          },
          "shot_intent": {
            "type": "string",
            "description": "WHY this shot exists — what purpose it serves in the video"
          },
          "narrative_role": {
            "type": "string",
            "enum": ["establish_context", "introduce_subject", "build_tension", "deliver_payload", "transition", "emotional_beat", "evidence", "comparison", "resolution", "call_to_action"],
            "description": "What role this scene plays in the narrative structure"
          },
          "information_role": {
            "type": "string",
            "description": "What the viewer learns or feels from this scene"
          },
          "hero_moment": {
            "type": "boolean",
            "default": false,
            "description": "True if this is the visual peak of the video — deserves extra attention"
          },
          "texture_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Visual texture descriptors: grain, clean, anamorphic, gritty, ethereal, etc."
          },
          "devices": {
            "type": "array",
            "description": "Reusable visual device references. When style_playbook is 'asymmetric', major scenes should reference one or more devices from channel_assets/asymmetric/diagrams/devices/manifest.json.",
            "items": {
              "type": "object",
              "required": ["device_id"],
              "properties": {
                "device_id": {
                  "type": "string",
                  "enum": [
                    "amber-pivot-marker",
                    "chokepoint-ring",
                    "route-trace",
                    "collapse-to-one-node",
                    "surface-vs-structure-split",
                    "xray-layer-reveal",
                    "blueprint-reveal",
                    "under-the-hood-mechanism",
                    "red-consequence-layer",
                    "source-card-reveal",
                    "final-leverage-map",
                    "dependency-tree-stop-point"
                  ]
                },
                "purpose": { "type": "string", "description": "Why this device is used in this scene." },
                "params": { "type": "object", "description": "Device input parameters (shape depends on device spec)." },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "state_changes": {
            "type": "array",
            "description": "State change timeline for motion enforcement (no static visual state > 4s). Times are seconds from scene start.",
            "items": {
              "type": "object",
              "required": ["t", "beat", "description", "visual_state_change"],
              "properties": {
                "t": { "type": "number", "minimum": 0 },
                "beat": { "type": "string", "description": "Short timeline label (e.g., 'pivot_acquire')." },
                "device_id": {
                  "type": "string",
                  "enum": [
                    "amber-pivot-marker",
                    "chokepoint-ring",
                    "route-trace",
                    "collapse-to-one-node",
                    "surface-vs-structure-split",
                    "xray-layer-reveal",
                    "blueprint-reveal",
                    "under-the-hood-mechanism",
                    "red-consequence-layer",
                    "source-card-reveal",
                    "final-leverage-map",
                    "dependency-tree-stop-point"
                  ]
                },
                "description": { "type": "string" },
                "visual_state_change": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "source_claim_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of claims from a source_map artifact that this scene (especially stat cards) relies on."
          },
          "qualifier_required": {
            "type": "boolean",
            "description": "True when this scene includes analyst/media estimates that must carry an on-screen qualifier."
          },
          "confidence_label": {
            "type": "string",
            "description": "Confidence label for the scene's key quantitative claim (e.g., high/medium/low/unknown)."
          },
          "evidence_device_id": {
            "type": "string",
            "enum": ["source-card-reveal"],
            "description": "Recommended evidence device for major non-obvious claims."
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "source": { "type": "string", "enum": ["generate", "source", "provided", "record"] },
                "file": { "type": "string", "description": "Optional path to an existing asset file." },
                "params": { "type": "object", "description": "Optional structured parameters for generating or transforming the asset." },
                "fallback_type": {
                  "type": "string",
                  "enum": ["svg_css", "hyperframes_native", "generated_image", "stock", "none"],
                  "description": "Fallback planning when generation fails or is blocked."
                },
                "fallback_path": { "type": "string", "description": "Optional path to an SVG/CSS/HyperFrames-native fallback asset." },
                "fallback_required": { "type": "boolean", "description": "If true, a fallback must exist for production to proceed." }
              },
              "required": ["type", "description", "source"]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "style_playbook": { "const": "asymmetric" } },
        "required": ["style_playbook"]
      },
      "then": {
        "properties": {
          "scenes": {
            "items": {
              "required": [
                "id",
                "type",
                "description",
                "start_seconds",
                "end_seconds",
                "viewer_hook",
                "tension_type",
                "visual_event_cadence_seconds",
                "retention_function",
                "payoff_moment",
                "next_open_loop"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
