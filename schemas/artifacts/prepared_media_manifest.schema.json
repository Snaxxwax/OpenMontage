{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreparedMediaManifest",
  "description": "Records preparation status of all assets before staging. Operator sets operator_approved_for_staging=true to unlock staging.",
  "type": "object",
  "required": ["episode_id", "operator_approved_for_staging", "assets"],
  "additionalProperties": false,
  "properties": {
    "episode_id": { "type": "string", "minLength": 1 },
    "operator_approved_for_staging": { "type": "boolean" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/prepared_asset" }
    }
  },
  "definitions": {
    "prepared_asset": {
      "type": "object",
      "required": [
        "asset_id",
        "media_type",
        "role",
        "input_path",
        "prepared_path",
        "source_label_required",
        "preparation_status",
        "qc_notes"
      ],
      "properties": {
        "asset_id":            { "type": "string", "minLength": 1 },
        "media_type":          { "type": "string", "enum": ["screenshot", "video", "audio"] },
        "role":                { "type": "string", "minLength": 1 },
        "input_path":          { "type": "string", "minLength": 1 },
        "prepared_path":       { "type": "string", "minLength": 1 },
        "source_label_required": { "type": "boolean" },
        "source_label":        { "type": "string", "minLength": 1 },
        "preparation_status":  { "type": "string", "enum": ["raw", "prepared", "failed"] },
        "qc_notes":            { "type": "string" },
        "legibility_ok":       { "type": "boolean" },
        "framing":             { "type": "string", "minLength": 1 },
        "render_treatment":    { "type": "string", "minLength": 1 },
        "in_seconds":          { "type": "number", "minimum": 0 },
        "out_seconds":         { "type": "number", "minimum": 0 },
        "duration_seconds":    { "type": "number", "exclusiveMinimum": 0 },
        "audio_role":          { "type": "string", "minLength": 1 },
        "loudness_lufs":       { "type": "number" },
        "silence_gate_passed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_label_required": { "const": true } },
            "required": ["source_label_required"]
          },
          "then": { "required": ["source_label"] }
        },
        {
          "if": {
            "properties": { "media_type": { "const": "screenshot" } },
            "required": ["media_type"]
          },
          "then": { "required": ["legibility_ok", "framing", "render_treatment"] }
        },
        {
          "if": {
            "properties": { "media_type": { "const": "video" } },
            "required": ["media_type"]
          },
          "then": { "required": ["in_seconds", "out_seconds", "duration_seconds", "framing", "audio_role"] }
        },
        {
          "if": {
            "properties": { "media_type": { "const": "audio" } },
            "required": ["media_type"]
          },
          "then": { "required": ["duration_seconds", "audio_role", "loudness_lufs"] }
        },
        {
          "if": {
            "properties": { "role": { "const": "narration" } },
            "required": ["role"]
          },
          "then": { "required": ["silence_gate_passed"] }
        }
      ]
    }
  }
}
