{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/edit_decisions",
  "title": "Edit Decisions",
  "description": "Editorial decisions produced by the Edit Agent.",
  "type": "object",
  "required": ["version", "cuts"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "in_seconds", "out_seconds"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "description": "Source file path or asset-manifest ID" },
          "in_seconds": { "type": "number", "minimum": 0 },
          "out_seconds": { "type": "number", "minimum": 0 },
          "type": {
            "type": "string",
            "description": "Remotion scene/component type when source is not a media file",
            "enum": [
              "text_card",
              "stat_card",
              "callout",
              "comparison",
              "progress_bar",
              "bar_chart",
              "line_chart",
              "pie_chart",
              "kpi_grid",
              "hero_title",
              "europe_map",
              "usa_states_map",
              "anime_scene"
            ]
          },
          "text": { "type": "string", "description": "Primary text for component scenes" },
          "stat": { "type": "string", "description": "Primary stat value for stat_card scenes" },
          "subtitle": { "type": "string", "description": "Subtitle/label text for component scenes" },
          "title": { "type": "string", "description": "Title text for charts/callouts/comparisons" },
          "callout_type": { "type": "string", "enum": ["info", "warning", "tip", "quote"] },
          "leftLabel": { "type": "string" },
          "rightLabel": { "type": "string" },
          "leftValue": { "type": "string" },
          "rightValue": { "type": "string" },
          "chartData": { "type": "array" },
          "chartSeries": { "type": "array" },
          "chartColors": { "type": "array", "items": { "type": "string" } },
          "chartAnimation": { "type": "string" },
          "donut": { "type": "boolean" },
          "centerLabel": { "type": "string" },
          "centerValue": { "type": "string" },
          "showGrid": { "type": "boolean" },
          "showValues": { "type": "boolean" },
          "showLegend": { "type": "boolean" },
          "showMarkers": { "type": "boolean" },
          "xLabel": { "type": "string" },
          "yLabel": { "type": "string" },
          "columns": { "type": "integer", "enum": [2, 3, 4] },
          "progress": { "type": "number", "minimum": 0, "maximum": 1 },
          "progressLabel": { "type": "string" },
          "progressColor": { "type": "string" },
          "progressAnimation": { "type": "string" },
          "progressSegments": { "type": "array" },
          "heroSubtitle": { "type": "string" },
          "backgroundColor": { "type": "string" },
          "backgroundImage": { "type": "string" },
          "backgroundOverlay": { "type": "number", "minimum": 0, "maximum": 1 },
          "color": { "type": "string" },
          "accentColor": { "type": "string" },
          "fontSize": { "type": "number" },
          "animation": { "type": "string" },
          "speed": { "type": "number", "minimum": 0.1, "default": 1.0 },
          "layer": {
            "type": "string",
            "enum": ["primary", "overlay", "background"],
            "default": "primary"
          },
          "transform": {
            "type": "object",
            "properties": {
              "scale": { "type": "number", "minimum": 0, "default": 1.0 },
              "position": { "type": "string", "default": "center" },
              "animation": {
                "type": "string",
                "description": "Motion applied to still images (e.g. ken-burns-slow-zoom, pan-left, static)"
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number" },
                  "height": { "type": "number" }
                }
              }
            },
            "additionalProperties": false
          },
          "transition_in": {
            "type": "string",
            "description": "Transition type entering this cut (e.g. fade, dissolve, cut, wipe)"
          },
          "transition_out": {
            "type": "string",
            "description": "Transition type leaving this cut"
          },
          "transition_duration": {
            "type": "number",
            "minimum": 0,
            "description": "Duration of transition in seconds"
          },
          "reason": { "type": "string" },
          "continuous_camera": {
            "type": "boolean",
            "default": false,
            "description": "Wrap this cut in ContinuousCamera to guarantee pixel motion via animation cycling"
          }
        },
        "additionalProperties": false
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "start_seconds", "end_seconds", "position"],
        "properties": {
          "asset_id": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            },
            "required": ["x", "y"]
          },
          "animation": { "type": "string" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "type": {
            "type": "string",
            "enum": ["section_title", "stat_reveal", "hero_title", "kinetic_highlight", "data_counter", "connecting_line"],
            "description": "Overlay component type. Omit for legacy overlays that predate micro-component routing."
          },
          "word_trigger": {
            "type": "object",
            "description": "Snap overlay timing to a word in word_timestamps.json. word_index is GLOBAL across all narration sections.",
            "required": ["word_index"],
            "properties": {
              "word_index": { "type": "integer", "minimum": 0 },
              "offset_seconds": { "type": "number", "default": 0 }
            },
            "additionalProperties": false
          },
          "micro_component_props": {
            "type": "object",
            "description": "Type-specific props forwarded to kinetic_highlight / data_counter / connecting_line components"
          }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "description": "Audio configuration for narration, music, and SFX.",
      "properties": {
        "narration": {
          "oneOf": [
            {
              "type": "object",
              "required": ["src"],
              "properties": {
                "src": { "type": "string", "description": "Narration audio path/URI" },
                "volume": { "type": "number", "minimum": 0, "maximum": 2 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["asset_id", "start_seconds"],
                    "properties": {
                      "asset_id": { "type": "string" },
                      "start_seconds": { "type": "number", "minimum": 0 },
                      "end_seconds": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "music": {
          "type": "object",
          "properties": {
            "asset_id": { "type": "string" },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "fade_in_seconds": { "type": "number", "minimum": 0 },
            "fade_out_seconds": { "type": "number", "minimum": 0 },
            "ducking": {
              "oneOf": [
                { "type": "boolean" },
                {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean", "default": true },
                    "threshold_db": { "type": "number" },
                    "reduction_db": { "type": "number" },
                    "attack_ms": { "type": "number", "minimum": 0 },
                    "release_ms": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "music_cues": {
          "type": "array",
          "description": "Per-scene timed music clips. Each plays only within its window with fade in/out.",
          "items": {
            "type": "object",
            "required": ["asset_id", "start_seconds", "end_seconds"],
            "properties": {
              "asset_id": { "type": "string" },
              "start_seconds": { "type": "number", "minimum": 0 },
              "end_seconds": { "type": "number", "minimum": 0 },
              "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
              "fade_in_seconds": { "type": "number", "minimum": 0, "default": 1.0 },
              "fade_out_seconds": { "type": "number", "minimum": 0, "default": 1.5 },
              "label": { "type": "string", "description": "Human label e.g. 'intro-swell', 'tension-sting'" }
            },
            "additionalProperties": false
          }
        },
        "sfx": {
          "type": "array",
          "description": "Spot sound effects. Each plays from start_seconds for its natural duration.",
          "items": {
            "type": "object",
            "required": ["asset_id", "start_seconds"],
            "properties": {
              "asset_id": { "type": "string" },
              "start_seconds": { "type": "number", "minimum": 0 },
              "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
              "label": { "type": "string", "description": "Human label e.g. 'typewriter-click', 'paper-rustle'" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "subtitles": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { "type": "string", "description": "Display style: sentence, word-by-word, karaoke" },
        "source": { "type": "string", "description": "Path to subtitle file or asset ID" },
        "font": { "type": "string" },
        "font_size": { "type": "integer" },
        "color": { "type": "string", "description": "Primary text color (hex or ASS format)" },
        "outline_color": { "type": "string" },
        "background": { "type": "string", "description": "Background color with optional alpha (e.g. #00000088)" },
        "position": { "type": "string", "enum": ["top-center", "bottom-center", "center"] },
        "max_words_per_line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "description": "Legacy top-level music config. Prefer audio.music for new pipelines.",
      "properties": {
        "asset_id": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "ducking": { "type": "boolean", "default": true },
        "fade_in_seconds": { "type": "number", "minimum": 0 },
        "fade_out_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "transitions": {
      "type": "array",
      "description": "Global transition list. Per-cut transitions in cuts[].transition_in/out are preferred.",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "at_seconds": { "type": "number" },
          "duration_seconds": { "type": "number", "minimum": 0 }
        },
        "required": ["type", "at_seconds", "duration_seconds"]
      }
    },
    "renderer_family": {
      "type": "string",
      "enum": ["explainer-data", "explainer-teacher", "cinematic-trailer", "product-reveal", "screen-demo", "presenter", "animation-first"],
      "description": "Locked at proposal stage — determines which Remotion composition renders this video"
    },
    "slideshow_risk_score": {
      "type": "object",
      "description": "Slideshow risk assessment from lib/slideshow_risk.py",
      "properties": {
        "average": { "type": "number" },
        "verdict": { "type": "string", "enum": ["strong", "acceptable", "revise", "fail"] },
        "dimensions": {
          "type": "object",
          "description": "Per-dimension scores from score_slideshow_risk(), including cut_density (7th dimension)"
        }
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
