{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerformanceBrief",
  "description": "Pre-render editorial gate. Forces hook, stakes, opening plan, and pacing decisions before claim mapping and source work begins.",
  "type": "object",
  "required": [
    "version",
    "episode_id",
    "viewer_promise",
    "opening_claim",
    "stakes",
    "title_angle",
    "thumbnail_angle",
    "first_15_seconds_plan",
    "retention_risks",
    "boring_parts_to_cut",
    "visual_pacing_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "viewer_promise": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what does the viewer understand by the end that they did not before?"
    },
    "opening_claim": {
      "type": "string",
      "minLength": 1,
      "description": "A concrete already-happened fact that opens the video. Not a question. Not a statistic alone."
    },
    "stakes": {
      "type": "string",
      "minLength": 1,
      "description": "Who wins, who loses, what changes. Must be legible before scripting begins."
    },
    "title_angle": {
      "type": "object",
      "required": ["title", "pillar", "engine"],
      "additionalProperties": false,
      "properties": {
        "title":  { "type": "string", "minLength": 1 },
        "pillar": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1, "description": "Which title engine pattern applies." }
      }
    },
    "thumbnail_angle": {
      "type": "object",
      "required": ["family", "variant", "headline_text"],
      "additionalProperties": false,
      "properties": {
        "family":        { "type": "string", "minLength": 1 },
        "variant":       { "type": "string", "enum": ["power", "mechanism", "consequence"] },
        "headline_text": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
    },
    "first_15_seconds_plan": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["beat", "seconds", "what_happens"],
        "additionalProperties": false,
        "properties": {
          "beat":         { "type": "integer", "minimum": 1 },
          "seconds":      { "type": "string", "minLength": 1 },
          "what_happens": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retention_risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "boring_parts_to_cut": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "visual_pacing_notes": {
      "type": "string",
      "minLength": 1,
      "description": "Visual movement plan — what changes and how often to prevent static slideshow pacing."
    },
    "why_now": {
      "type": "string",
      "description": "Optional timeliness hook. Cite the live cultural moment if not evergreen."
    },
    "source_density_plan": {
      "type": "string",
      "description": "Optional: how evidence density is distributed across the video timeline."
    }
  }
}
