{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/extracted_clip_manifest",
  "title": "Extracted Clip Manifest",
  "description": "List of locally extracted media clips corresponding to approved receipts.",
  "type": "object",
  "required": ["version", "project_id", "clips"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_id",
          "local_clip_path",
          "source_id",
          "in_seconds",
          "out_seconds",
          "duration_seconds",
          "checksum_sha256"
        ],
        "properties": {
          "receipt_id": { "type": "string" },
          "local_clip_path": { "type": "string" },
          "source_id": { "type": "string" },
          "in_seconds": { "type": "number", "minimum": 0 },
          "out_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
