{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/intent_contract",
  "title": "Intent Contract",
  "description": "Editorial intent contract that separates the immutable campaign promise from the parts of the story that may adapt to current events.",
  "type": "object",
  "required": [
    "version",
    "anchor_title",
    "temporal_update_policy",
    "must_keep",
    "can_change"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "anchor_title": { "type": "string", "minLength": 3 },
    "anchor_hook": { "type": "string" },
    "value_promise": { "type": "string" },
    "target_audience": { "type": "string" },
    "temporal_update_policy": {
      "type": "string",
      "enum": ["none", "supporting_facts_only", "re-angle_allowed"]
    },
    "freshness_basis_date": {
      "type": "string",
      "format": "date",
      "description": "Absolute date that current-event updates should be evaluated against."
    },
    "must_keep": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "can_change": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "prohibited_changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
