{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualMotionPlan",
  "description": "Per-shot motion specification for the motion card pre-render step. Drives asymmetric_motion_cards.py.",
  "type": "object",
  "required": ["version", "episode_id", "shots"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "default_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "source_card_id",
          "input_path",
          "output_path",
          "duration_seconds",
          "motion_type"
        ],
        "additionalProperties": false,
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source_card_id": {
            "type": "string",
            "minLength": 1
          },
          "input_path": {
            "type": "string",
            "allOf": [
              { "pattern": "^[^/]" },
              { "not": { "pattern": "\\.\\." } }
            ]
          },
          "output_path": {
            "type": "string",
            "allOf": [
              { "pattern": "^assets/motion/" },
              { "not": { "pattern": "\\.\\." } }
            ]
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "motion_type": {
            "type": "string",
            "enum": ["push_in", "pull_out", "static"]
          },
          "start_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "end_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pan_x": {
            "type": "number"
          },
          "pan_y": {
            "type": "number"
          }
        }
      }
    }
  }
}
