{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/source_candidate_manifest",
  "title": "Source Candidate Manifest",
  "description": "List of discovered source candidates (metadata only). Downloads prohibited.",
  "type": "object",
  "required": ["version", "project_id", "sources"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_url",
          "source_title",
          "source_channel",
          "platform",
          "transcript_available",
          "metadata_only_collected"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "source_title": { "type": "string" },
          "source_channel": { "type": "string" },
          "platform": {
            "type": "string",
            "enum": ["youtube", "vimeo", "tiktok", "instagram", "twitter", "other"]
          },
          "transcript_available": { "type": "boolean" },
          "metadata_only_collected": { "type": "boolean", "const": true },
          "duration_seconds": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
