{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceCandidateManifest",
  "type": "object",
  "required": ["topic", "sources"],
  "properties": {
    "topic": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "kind", "relevance"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "vendor_page",
              "technical_disclosure",
              "researcher_post",
              "paper",
              "github_issue_or_pr",
              "news_article",
              "social_post",
              "youtube_video",
              "forum_thread",
              "archive_snapshot",
              "documentation",
              "demo"
            ]
          },
          "relevance": { "type": "string" },
          "capture_potential": {
            "type": "string",
            "enum": ["none", "screenshot", "clip", "transcript", "screenshot_and_clip", "unknown"]
          },
          "credibility_notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
